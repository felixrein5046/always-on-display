<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/intro"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/enable"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- Berechtigungen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/permissions"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <Button
            android:id="@+id/btnOverlay"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnNotifAccess"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnBattery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Optionen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/options"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCharging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/only_charging" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSingleTap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/single_tap" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_notifications" />

        <!-- Widgets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/widgets"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_alarm" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_calendar" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_media" />

        <Button
            android:id="@+id/btnWidget"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/labelBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="100" />

        <TextView
            android:id="@+id/labelTimeout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="120" />

        <TextView
            android:id="@+id/labelMinBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMinBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="50" />

        <Button
            android:id="@+id/btnPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/preview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tip"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
